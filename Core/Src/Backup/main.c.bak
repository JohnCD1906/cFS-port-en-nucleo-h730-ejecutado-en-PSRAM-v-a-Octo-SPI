/**
  ******************************************************************************
  * @file     : main.c
  * @brief    : MI APP - Bring-up phase 1 (clon de Test_LED con banner propio)
  * @target   : STM32H730IBT6Q
  * @desc     : Validación del pipeline compilación → grabación → ejecución
  *             desde PSRAM @ 0x90000000 (cargado vía Boot App externa).
  ******************************************************************************
  */
